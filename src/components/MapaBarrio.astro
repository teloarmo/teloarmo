---
// Mapa ilustrado de un barrio. Cada pin rojo es un link a una página de ejemplo;
// el pin amarillo "Tu negocio aquí" lleva al contacto.
// Hay dos versiones del mismo mapa: una ancha (tablet y escritorio) y una compacta
// para celular, con etiquetas más grandes para que se lean.
import { ejemplos } from '../data/negocios';

type Punto = { x: number; y: number; lado: 'der' | 'izq' };

interface Variante {
  id: string;
  clase: string;
  W: number;
  H: number;
  letra: number; // tamaño de letra de las etiquetas
  calles: { d: string; w: number }[];
  avenida: { x1: number; y1: number; x2: number; y2: number };
  rotuloAvenida: { x: number; y: number };
  rotuloCalle: { x: number; y: number; tam: number };
  plaza: { x: number; y: number; w: number; h: number };
  arboles: [number, number, number][];
  casas: [number, number, number, number][];
  pines: Record<string, Punto>;
  tuyo: { x: number; y: number };
}

const variantes: Variante[] = [
  {
    id: 'ancho',
    clase: 'hidden sm:block',
    W: 640,
    H: 520,
    letra: 14,
    calles: [
      { d: 'M0 120H640', w: 16 },
      { d: 'M0 300H640', w: 18 },
      { d: 'M0 450H640', w: 14 },
      { d: 'M170 0V520', w: 16 },
      { d: 'M360 0V520', w: 18 },
      { d: 'M540 0V520', w: 14 },
    ],
    avenida: { x1: -10, y1: 426, x2: 650, y2: 55 },
    rotuloAvenida: { x: 318, y: 241 },
    rotuloCalle: { x: 24, y: 304, tam: 11 },
    plaza: { x: 374, y: 314, w: 152, h: 122 },
    arboles: [
      [402, 342, 10],
      [436, 372, 12],
      [482, 340, 9],
      [500, 404, 11],
      [414, 410, 9],
    ],
    casas: [
      [18, 16, 62, 40],
      [92, 16, 58, 72],
      [196, 18, 70, 44],
      [388, 150, 56, 46],
      [566, 140, 56, 70],
      [566, 330, 58, 96],
      [22, 330, 58, 52],
      [22, 472, 120, 34],
    ],
    pines: {
      almacen: { x: 105, y: 232, lado: 'der' },
      panaderia: { x: 470, y: 104, lado: 'izq' },
      ferreteria: { x: 252, y: 500, lado: 'der' },
    },
    tuyo: { x: 262, y: 372 },
  },
  {
    id: 'compacto',
    clase: 'sm:hidden',
    W: 400,
    H: 470,
    letra: 16,
    calles: [
      { d: 'M0 100H400', w: 14 },
      { d: 'M0 270H400', w: 16 },
      { d: 'M0 410H400', w: 12 },
      { d: 'M130 0V470', w: 14 },
      { d: 'M290 0V470', w: 16 },
    ],
    avenida: { x1: -10, y1: 390, x2: 410, y2: 80 },
    rotuloAvenida: { x: 196, y: 238 },
    rotuloCalle: { x: 10, y: 274, tam: 10 },
    plaza: { x: 300, y: 280, w: 92, h: 120 },
    arboles: [
      [322, 304, 9],
      [362, 330, 11],
      [326, 372, 10],
      [372, 384, 8],
    ],
    casas: [
      [12, 12, 56, 38],
      [146, 14, 60, 34],
      [304, 116, 60, 40],
      [12, 420, 100, 34],
    ],
    pines: {
      almacen: { x: 58, y: 214, lado: 'der' },
      panaderia: { x: 336, y: 74, lado: 'izq' },
      ferreteria: { x: 84, y: 462, lado: 'der' },
    },
    tuyo: { x: 196, y: 350 },
  },
];

const pinPath = 'M0 0C-6-9-15-17-15-29a15 15 0 1 1 30 0C15-17 6-9 0 0Z';

const mapas = variantes.map((v) => {
  const alto = Math.round(v.letra * 2.15);
  const anchoEtiqueta = (texto: string) => Math.round(texto.length * v.letra * 0.58 + v.letra * 1.9);
  const pines = ejemplos
    .filter((n) => v.pines[n.slug])
    .map((n) => {
      const p = v.pines[n.slug];
      const w = anchoEtiqueta(n.nombre);
      return {
        ...p,
        nombre: n.nombre,
        href: `/demos/${n.slug}`,
        w,
        ex: p.lado === 'der' ? p.x + 20 : p.x - 20 - w,
        ey: p.y - 30 - alto / 2,
      };
    });
  const a = v.avenida;
  const angulo = (Math.atan2(a.y2 - a.y1, a.x2 - a.x1) * 180) / Math.PI;
  const textoTuyo = 'Tu negocio aquí';
  const tuyo = {
    ...v.tuyo,
    w: anchoEtiqueta(textoTuyo) + 4,
    ex: v.tuyo.x + 26,
    ey: v.tuyo.y - 38 - alto / 2,
    texto: textoTuyo,
  };
  return { ...v, alto, pines, angulo, tuyo };
});

const fuente = 'Atkinson Hyperlegible Next Variable, sans-serif';
---

{
  mapas.map((m) => (
    <svg
      viewBox={`0 0 ${m.W} ${m.H}`}
      class:list={['h-auto w-full rounded-[22px] border border-linea', m.clase]}
      role="group"
      aria-label="Mapa ilustrado de un barrio con tres negocios de ejemplo"
    >
      <rect width={m.W} height={m.H} fill="#d9ddcf" />
      <g fill="#e2e5d9">
        {m.casas.map(([x, y, w, h]) => (
          <rect x={x} y={y} width={w} height={h} rx="4" />
        ))}
      </g>
      <rect x={m.plaza.x} y={m.plaza.y} width={m.plaza.w} height={m.plaza.h} rx="10" fill="#a9cfa6" />
      <g fill="#8fbf8c">
        {m.arboles.map(([cx, cy, r]) => (
          <circle cx={cx} cy={cy} r={r} />
        ))}
      </g>
      <g stroke="#fff" fill="none">
        {m.calles.map((c) => (
          <path d={c.d} stroke-width={c.w} />
        ))}
      </g>
      <path
        d={`M${m.avenida.x1} ${m.avenida.y1}L${m.avenida.x2} ${m.avenida.y2}`}
        stroke="#e7c04f"
        stroke-width="31"
        fill="none"
      />
      <path
        d={`M${m.avenida.x1} ${m.avenida.y1}L${m.avenida.x2} ${m.avenida.y2}`}
        stroke="#f6d66b"
        stroke-width="25"
        fill="none"
      />
      <text
        transform={`translate(${m.rotuloAvenida.x} ${m.rotuloAvenida.y}) rotate(${m.angulo.toFixed(1)})`}
        text-anchor="middle"
        font-size="12.5"
        font-weight="700"
        fill="#7a6620"
        letter-spacing="0.5"
        font-family={fuente}
      >
        Avenida Principal
      </text>
      <text x={m.rotuloCalle.x} y={m.rotuloCalle.y} font-size={m.rotuloCalle.tam} fill="#7f8a83" font-family={fuente}>
        Calle Los Olmos
      </text>

      {m.pines.map((p) => (
        <a href={p.href} class="pin-link" aria-label={`Ver la página de ejemplo de ${p.nombre}`}>
          <ellipse cx={p.x} cy={p.y} rx="7" ry="2.5" fill="#1f2a30" opacity="0.25" />
          <g transform={`translate(${p.x} ${p.y})`}>
            <path d={pinPath} fill="#d7372a" />
            <circle cx="0" cy="-29" r="5.5" fill="#fff" />
          </g>
          <rect
            class="chip"
            x={p.ex}
            y={p.ey}
            width={p.w}
            height={m.alto}
            rx={m.alto / 2}
            fill="#fff"
            stroke="#1f2a30"
            stroke-opacity="0.15"
          />
          <text
            class="chip-texto"
            x={p.ex + m.letra * 0.95}
            y={p.ey + m.alto / 2 + m.letra * 0.36}
            font-size={m.letra}
            font-weight="700"
            fill="#1f2a30"
            font-family={fuente}
          >
            {p.nombre}
          </text>
        </a>
      ))}

      <a href="#contacto" class="pin-link" aria-label="Tu negocio aquí: ir a contacto">
        <ellipse cx={m.tuyo.x} cy={m.tuyo.y} rx="9" ry="3" fill="#1f2a30" opacity="0.3" />
        <g transform={`translate(${m.tuyo.x} ${m.tuyo.y})`}>
          <g class="pin-tuyo">
            <path d={pinPath} transform="scale(1.3)" fill="#f2c230" stroke="#1f2a30" stroke-width="1.6" />
            <circle cx="0" cy="-37.7" r="7" fill="#1f2a30" />
          </g>
        </g>
        <rect
          class="chip chip-oscuro"
          x={m.tuyo.ex}
          y={m.tuyo.ey}
          width={m.tuyo.w}
          height={m.alto}
          rx={m.alto / 2}
          fill="#1f2a30"
        />
        <text
          class="chip-texto chip-texto-claro"
          x={m.tuyo.ex + m.letra * 0.95}
          y={m.tuyo.ey + m.alto / 2 + m.letra * 0.36}
          font-size={m.letra}
          font-weight="700"
          fill="#fff"
          font-family={fuente}
        >
          {m.tuyo.texto}
        </text>
      </a>
    </svg>
  ))
}

<style>
  .pin-link {
    cursor: pointer;
    outline: none;
  }
  .pin-link:hover .chip,
  .pin-link:focus-visible .chip {
    fill: #1f2a30;
    stroke: #d7372a;
    stroke-width: 3;
    stroke-opacity: 1;
  }
  .pin-link:hover .chip-texto,
  .pin-link:focus-visible .chip-texto {
    fill: #fff;
  }
  .pin-link:hover .chip-oscuro,
  .pin-link:focus-visible .chip-oscuro {
    fill: #d7372a;
    stroke: #1f2a30;
  }

  /* El único movimiento automático de la página: el pin amarillo cae en su lugar. */
  .pin-tuyo {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: caer 0.9s cubic-bezier(0.3, 0.7, 0.4, 1) 0.4s both;
  }
  @keyframes caer {
    0% {
      transform: translateY(-70px);
      opacity: 0;
    }
    55% {
      transform: translateY(0) scaleY(0.9);
      opacity: 1;
    }
    75% {
      transform: translateY(-6px) scaleY(1.02);
    }
    100% {
      transform: translateY(0) scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pin-tuyo {
      animation: none;
    }
  }
</style>
