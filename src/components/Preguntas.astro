---
// Lista de preguntas desplegables. Se usa en la web y en las páginas de negocio.
import Icono from './Icono.astro';

interface Props {
  items: { p: string; r: string }[];
}
const { items } = Astro.props;
---

<div class="preguntas divide-y border-y" style="border-color: var(--borde, var(--color-linea))">
  {
    items.map((it) => (
      <details class="group" style="border-color: var(--borde, var(--color-linea))">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold">
          <span>{it.p}</span>
          <Icono nombre="mas" class="size-6 shrink-0 transition-transform duration-200 group-open:rotate-45" />
        </summary>
        <p class="max-w-[62ch] pb-6 opacity-85">{it.r}</p>
      </details>
    ))
  }
</div>

<style>
  .preguntas summary::-webkit-details-marker {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .preguntas :global(svg) {
      transition: none;
    }
  }
</style>
