---
// Bolsa o lista de compra que se envía por WhatsApp con el detalle y el total escritos.
// Los colores salen de variables CSS de la página: --c-fondo, --c-texto, --c-marca,
// --c-sobre-marca (texto sobre el color de marca) y --c-linea.
//
// Botones que lo usan (en cualquier parte de la página):
//   data-carro-agregar data-id data-nombre data-precio [data-detalle] [data-talla="name del radio"]
//   data-carro-abrir         abre el panel
//   data-carro-cuenta        muestra la cantidad de unidades (se oculta en 0)
import Icono from '../Icono.astro';

interface Props {
  titulo: string; // "Tu lista", "Tu bolsa"
  enviar: string; // texto del botón de WhatsApp
  nota: string; // bajo el total
  vacio: string; // cuando no hay productos
  intro: string; // primera línea del mensaje
  numero: string; // WhatsApp, solo dígitos
  clave: string; // nombre para guardar en el navegador
  abrirAlAgregar?: boolean;
}
const { titulo, enviar, nota, vacio, intro, numero, clave, abrirAlAgregar = false } = Astro.props;
const config = { intro, numero, clave, abrirAlAgregar, titulo };
---

<dialog id="carro" class="carro" aria-labelledby="carro-titulo" data-config={JSON.stringify(config)}>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 px-6 py-5" style="border-bottom: 1px solid var(--c-linea)">
      <h2 id="carro-titulo" class="text-xl font-bold">{titulo}</h2>
      <button type="button" data-carro-cerrar class="-mr-2 rounded-full p-2" aria-label="Cerrar">
        <Icono nombre="cerrar" class="size-6" />
      </button>
    </div>
    <p data-carro-vacio class="px-6 py-10 opacity-70">{vacio}</p>
    <ul data-carro-lista class="flex-1 overflow-y-auto px-6"></ul>
    <div data-carro-pie class="px-6 py-5" style="border-top: 1px solid var(--c-linea)" hidden>
      <p class="flex items-baseline justify-between text-lg font-bold">
        <span>Total</span><span data-carro-total></span>
      </p>
      <p class="mt-1 text-sm opacity-70">{nota}</p>
      <a data-carro-enviar class="carro-enviar mt-4" href="#" target="_blank" rel="noopener">
        <Icono nombre="chat" class="size-5" />
        {enviar}
      </a>
      <button type="button" data-carro-vaciar class="mt-2 w-full py-2 text-sm underline underline-offset-4 opacity-80">
        Vaciar
      </button>
    </div>
  </div>
</dialog>

<div data-carro-toast class="carro-toast" role="status" aria-live="polite"></div>

<style>
  .carro {
    margin: 0 0 0 auto;
    width: min(100vw, 27rem);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--c-fondo);
    color: var(--c-texto);
    box-shadow: -24px 0 60px -20px rgb(0 0 0 / 0.35);
  }
  .carro[open] {
    animation: entrar 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .carro::backdrop {
    background: rgb(10 12 16 / 0.5);
    backdrop-filter: blur(2px);
  }
  @keyframes entrar {
    from {
      transform: translateX(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carro[open] {
      animation: none;
    }
  }
  .carro-enviar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    border-radius: var(--c-radio, 0.75rem);
    background: var(--c-marca);
    color: var(--c-sobre-marca, #fff);
    font-weight: 700;
  }
  .carro-enviar:hover {
    filter: brightness(0.92);
  }
  .carro :global(.paso) {
    display: flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--c-linea);
    border-radius: 999px;
  }
  .carro-toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: 70;
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    background: var(--c-texto);
    color: var(--c-fondo);
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.4);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.75rem);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .carro-toast.visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<script>
  import { precio, waLink } from '../../lib/formato';

  type Item = { clave: string; nombre: string; detalle: string; precio: number; cantidad: number };

  const dialogo = document.getElementById('carro') as HTMLDialogElement;
  const cfg = JSON.parse(dialogo.dataset.config!) as {
    intro: string;
    numero: string;
    clave: string;
    abrirAlAgregar: boolean;
    titulo: string;
  };
  const q = <T extends Element>(sel: string) => dialogo.querySelector(sel) as T;
  const lista = q<HTMLUListElement>('[data-carro-lista]');
  const vacio = q<HTMLElement>('[data-carro-vacio]');
  const pie = q<HTMLElement>('[data-carro-pie]');
  const totalEl = q<HTMLElement>('[data-carro-total]');
  const enviar = q<HTMLAnchorElement>('[data-carro-enviar]');
  const toast = document.querySelector('[data-carro-toast]') as HTMLElement;

  let items = new Map<string, Item>();
  try {
    (JSON.parse(localStorage.getItem(cfg.clave) ?? '[]') as Item[]).forEach((it) => items.set(it.clave, it));
  } catch {
    // Sin almacenamiento: la lista vive mientras la página esté abierta.
  }

  let timer: number | undefined;
  const avisar = (texto: string) => {
    toast.textContent = texto;
    toast.classList.add('visible');
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove('visible'), 2200);
  };

  const pintar = () => {
    const todos = [...items.values()];
    const unidades = todos.reduce((s, it) => s + it.cantidad, 0);
    const total = todos.reduce((s, it) => s + it.precio * it.cantidad, 0);

    document.querySelectorAll<HTMLElement>('[data-carro-cuenta]').forEach((el) => {
      el.textContent = String(unidades);
      el.hidden = unidades === 0;
    });

    vacio.hidden = todos.length > 0;
    pie.hidden = todos.length === 0;
    lista.innerHTML = '';
    todos.forEach((it) => {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-3 py-4';
      li.style.borderBottom = '1px solid var(--c-linea)';

      const texto = document.createElement('div');
      texto.className = 'min-w-0 flex-1';
      const nombre = document.createElement('p');
      nombre.className = 'font-semibold leading-snug';
      nombre.textContent = it.nombre;
      const detalle = document.createElement('p');
      detalle.className = 'text-sm opacity-70';
      detalle.textContent = [it.detalle, precio(it.precio * it.cantidad)].filter(Boolean).join(' · ');
      texto.append(nombre, detalle);

      const ctrl = document.createElement('div');
      ctrl.className = 'flex items-center gap-2';
      const boton = (signo: string, delta: number, etiqueta: string) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'paso';
        b.textContent = signo;
        b.setAttribute('aria-label', `${etiqueta} ${it.nombre}`);
        b.addEventListener('click', () => cambiar(it.clave, delta));
        return b;
      };
      const cant = document.createElement('span');
      cant.className = 'w-5 text-center font-semibold';
      cant.textContent = String(it.cantidad);
      ctrl.append(boton('−', -1, 'Quitar uno de'), cant, boton('+', 1, 'Agregar uno de'));

      li.append(texto, ctrl);
      lista.append(li);
    });

    totalEl.textContent = precio(total);
    const lineas = todos.map(
      (it) => `- ${it.cantidad} x ${it.nombre}${it.detalle ? ` (${it.detalle})` : ''}: ${precio(it.precio * it.cantidad)}`,
    );
    enviar.href = waLink(cfg.numero, [cfg.intro, ...lineas, `Total: ${precio(total)}`].join('\n'));

    try {
      localStorage.setItem(cfg.clave, JSON.stringify(todos));
    } catch {
      /* nada */
    }
  };

  const cambiar = (clave: string, delta: number) => {
    const it = items.get(clave);
    if (!it) return;
    it.cantidad += delta;
    if (it.cantidad <= 0) items.delete(clave);
    pintar();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-carro-agregar]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const d = btn.dataset;
      let detalle = d.detalle ?? '';
      if (d.talla) {
        const elegido = document.querySelector<HTMLInputElement>(`input[name="${d.talla}"]:checked`);
        if (!elegido) {
          const grupo = document.querySelector<HTMLInputElement>(`input[name="${d.talla}"]`);
          grupo?.closest('fieldset')?.classList.add('falta-talla');
          grupo?.focus();
          avisar('Elige tu talla primero');
          return;
        }
        elegido.closest('fieldset')?.classList.remove('falta-talla');
        detalle = [detalle, `talla ${elegido.value}`].filter(Boolean).join(', ');
      }
      const clave = `${d.id}|${detalle}`;
      const it = items.get(clave);
      if (it) it.cantidad += 1;
      else items.set(clave, { clave, nombre: d.nombre!, detalle, precio: Number(d.precio), cantidad: 1 });
      pintar();
      if (cfg.abrirAlAgregar) dialogo.showModal();
      else avisar(`${d.nombre} agregado a ${cfg.titulo.toLowerCase()}`);
    });
  });

  document.querySelectorAll('[data-carro-abrir]').forEach((b) => b.addEventListener('click', () => dialogo.showModal()));
  q('[data-carro-cerrar]').addEventListener('click', () => dialogo.close());
  dialogo.addEventListener('click', (e) => {
    if (e.target === dialogo) dialogo.close();
  });
  q('[data-carro-vaciar]').addEventListener('click', () => {
    items = new Map();
    pintar();
  });

  pintar();
</script>
