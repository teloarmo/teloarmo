---
// Lo técnico, explicado simple. La ventana de código muestra los datos estructurados
// (schema.org) que llevan las páginas para que Google entienda el negocio.
import Icono, { type NombreIcono } from './Icono.astro';

const puntos: { icono: NombreIcono; titulo: string; texto: string }[] = [
  { icono: 'rayo', titulo: 'Carga al instante', texto: 'Páginas livianas servidas desde una red global. Abren rápido incluso con mala señal.' },
  { icono: 'celular', titulo: 'Celular y computador', texto: 'Se ve perfecta en cualquier pantalla: celular, tablet o computador, desde el primer día.' },
  { icono: 'buscar', titulo: 'Lista para Google', texto: 'Títulos, descripciones y datos estructurados para aparecer en la búsqueda y en Google Maps.' },
  { icono: 'grafico', titulo: 'Google Analytics', texto: 'Ves cuántos te visitan, desde dónde llegan y cuáles son tus productos estrella.' },
  { icono: 'globo', titulo: 'Conectada', texto: 'WhatsApp, Instagram, tus redes, Google Maps y, cuando lo necesites, pagos online.' },
  { icono: 'codigo', titulo: 'Hecha a medida', texto: 'Nada de plantillas genéricas: código propio, diseñado para tu rubro.' },];
---

<section class="tecnologia relative isolate overflow-hidden py-24 text-white lg:py-32">
  <div class="cuadricula absolute inset-0 -z-10" style="--linea-cuadricula: rgb(255 255 255 / 0.05)" aria-hidden="true"></div>
  <div class="wrap grid gap-16 lg:grid-cols-[1.1fr_1fr] lg:items-center">
    <div>
      <p class="antetitulo revelar text-[#8fbde3]!">Tecnología</p>
      <h2 class="titulo revelar mt-4 max-w-[18ch]">Lo último en tecnología web, sin que tengas que entenderlo.</h2>
      <p class="revelar mt-5 max-w-[50ch] text-[1.2rem] text-white/70">
        Somos desarrolladores. Usamos las mismas herramientas modernas que las empresas grandes, y nos encargamos de
        todo lo técnico por ti.
      </p>
      <ul class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          puntos.map((p, i) => (
            <li class="revelar flex gap-4" style={`--retraso:${(i % 2) * 90}ms`}>
              <span class="icono flex size-11 shrink-0 items-center justify-center rounded-xl text-[#8fbde3]">
                <Icono nombre={p.icono} class="size-5" />
              </span>
              <div>
                <h3 class="font-bold">{p.titulo}</h3>
                <p class="mt-1 text-base text-white/65">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="revelar">
      <div class="codigo overflow-hidden rounded-2xl">
        <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
          <span class="flex gap-1.5" aria-hidden="true">
            <i class="size-2.5 rounded-full bg-white/20"></i>
            <i class="size-2.5 rounded-full bg-white/20"></i>
            <i class="size-2.5 rounded-full bg-white/20"></i>
          </span>
          <span class="font-mono text-xs text-white/50">tu-negocio.cl / index.html</span>
        </div>
        <pre class="overflow-x-auto p-5 font-mono text-[0.82rem] leading-relaxed sm:text-sm"><code><span class="c-gris">&lt;!-- Así le explicamos tu negocio a Google --&gt;</span>
<span class="c-azul">&lt;script</span> <span class="c-celeste">type</span>=<span class="c-verde">"application/ld+json"</span><span class="c-azul">&gt;</span>
{'{'}
  <span class="c-celeste">"@type"</span>: <span class="c-verde">"HardwareStore"</span>,
  <span class="c-celeste">"name"</span>: <span class="c-verde">"Ferretería El Perno"</span>,
  <span class="c-celeste">"address"</span>: <span class="c-verde">"La Florida, Santiago"</span>,
  <span class="c-celeste">"openingHours"</span>: [<span class="c-verde">"Mo-Fr 08:30-19:30"</span>],
  <span class="c-celeste">"aggregateRating"</span>: {'{'} <span class="c-celeste">"ratingValue"</span>: <span class="c-ambar">4.8</span> {'}'}
{'}'}
<span class="c-azul">&lt;/script&gt;</span></code></pre>
      </div>
      <figcaption class="mt-5 grid grid-cols-3 gap-3 text-center">
        <span class="dato rounded-xl px-3 py-4"><span class="font-display block text-2xl font-bold">HTTPS</span><span class="text-sm text-white/60">conexión segura</span></span>
        <span class="dato rounded-xl px-3 py-4"><span class="font-display block text-2xl font-bold">.cl</span><span class="text-sm text-white/60">dominio propio</span></span>
        <span class="dato rounded-xl px-3 py-4"><span class="font-display block text-2xl font-bold">24/7</span><span class="text-sm text-white/60">siempre en línea</span></span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .tecnologia {
    background:
      radial-gradient(50rem 30rem at 85% 10%, rgb(47 111 163 / 0.35), transparent 60%),
      radial-gradient(40rem 30rem at 0% 100%, rgb(47 111 163 / 0.18), transparent 60%),
      var(--color-tinta);
  }
  .icono {
    background: rgb(143 189 227 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(143 189 227 / 0.2);
  }
  .codigo {
    background: rgb(10 16 24 / 0.7);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 40px 80px -30px rgb(0 0 0 / 0.6);
  }
  .dato {
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .c-gris {
    color: rgb(255 255 255 / 0.4);
  }
  .c-azul {
    color: #7aa2f7;
  }
  .c-celeste {
    color: #8fbde3;
  }
  .c-verde {
    color: #9ece6a;
  }
  .c-ambar {
    color: #e0af68;
  }
</style>
