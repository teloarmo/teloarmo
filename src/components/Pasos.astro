---
import Icono, { type NombreIcono } from './Icono.astro';

const pasos: { icono: NombreIcono; titulo: string; texto: string }[] = [
  {
    icono: 'chat',
    titulo: 'Conversamos 20 minutos',
    texto: 'Por videollamada. Nos cuentas cómo vendes, quiénes son tus clientes y qué quieres lograr.',
  },
  {
    icono: 'ojo',
    titulo: 'Te mostramos cómo se vería',
    texto: 'Diseñamos la portada de tu página con tu marca, gratis y sin compromiso.',
  },
  {
    icono: 'lista',
    titulo: 'Te enviamos una propuesta',
    texto: 'Con lo que incluye, cómo va a ayudar a tu negocio y las fechas de entrega.',
  },
  {
    icono: 'herramienta',
    titulo: 'La armamos contigo',
    texto: 'Revisas la página dos veces durante el proceso y nos pides los cambios que necesites.',
  },
  {
    icono: 'rayo',
    titulo: 'Te la entregamos lista',
    texto: 'La publicamos con tu dominio, dejamos tu ficha de Google al día y te enseñamos a actualizarla.',
  },
];
---

<section id="como-trabajamos" class="py-24 lg:py-32">
  <div class="wrap">
    <div class="revelar flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="antetitulo">Cómo trabajamos</p>
        <h2 class="titulo mt-4 max-w-[20ch]">De la primera conversación a tu página vendiendo.</h2>
      </div>
      <p class="max-w-[38ch] text-gris">Cinco pasos simples. Tú te ocupas de tu negocio; nosotros, de todo lo técnico.</p>
    </div>
    <ol class="ruta mt-14 grid gap-4 lg:grid-cols-5">
      {
        pasos.map((p, i) => (
          <li class="paso revelar relative rounded-2xl p-6" style={`--retraso:${i * 90}ms`}>
            <div class="flex items-center justify-between">
              <span class="flex size-11 items-center justify-center rounded-xl bg-azul text-white">
                <Icono nombre={p.icono} class="size-5" />
              </span>
              <span class="font-display text-4xl font-bold text-linea">0{i + 1}</span>
            </div>
            <h3 class="mt-6 text-xl leading-snug font-bold">{p.titulo}</h3>
            <p class="mt-2 text-base text-gris">{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .paso {
    border: 1px solid var(--color-linea);
    background: linear-gradient(180deg, #fff, var(--color-suave));
    transition:
      border-color 0.3s,
      transform 0.3s;
  }
  .paso:hover {
    border-color: color-mix(in srgb, var(--color-azul) 45%, var(--color-linea));
    transform: translateY(-3px);
  }
</style>
