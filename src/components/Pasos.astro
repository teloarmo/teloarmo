---
const pasos = [
  {
    titulo: 'Conversamos 20 minutos',
    texto: 'En tu local o por videollamada. Nos cuentas cómo vendes y qué te preguntan tus clientes.',
  },
  {
    titulo: 'Te mostramos cómo se vería',
    texto: 'Diseñamos la portada de tu página con tu marca, gratis y sin compromiso.',
  },
  {
    titulo: 'Te enviamos una propuesta',
    texto: 'Con el precio, lo que incluye y las fechas de entrega. Para partir, pagas la mitad.',
  },
  {
    titulo: 'La armamos contigo',
    texto: 'Revisas la página dos veces durante el proceso y nos pides los cambios que necesites.',
  },
  {
    titulo: 'Te la entregamos lista',
    texto: 'Pagas el saldo, la publicamos con tu dominio y te enseñamos a actualizarla.',
  },
];
---

<section id="como-trabajamos" class="py-20 lg:py-24">
  <div class="wrap">
    <h2 class="titulo max-w-[20ch]">Cómo trabajamos</h2>
    <p class="mt-4 max-w-[46ch] text-gris">De la primera conversación a la página publicada, en cinco pasos.</p>
    <ol class="ruta mt-12 grid gap-9 lg:grid-cols-5 lg:gap-7">
      {
        pasos.map((p, i) => (
          <li class="relative pl-16 lg:pl-0">
            <span class="numero font-display absolute top-0 left-0 flex size-12 items-center justify-center rounded-full bg-tinta text-xl font-bold text-white lg:static">
              {i + 1}
            </span>
            <h3 class="text-xl font-bold lg:mt-5">{p.titulo}</h3>
            <p class="mt-1.5 text-gris">{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Línea de ruta punteada que une las paradas. */
  .ruta {
    position: relative;
  }
  .ruta::before {
    content: '';
    position: absolute;
    left: 1.5rem;
    top: 1.5rem;
    bottom: 1.5rem;
    border-left: 2px dashed color-mix(in srgb, var(--color-tinta) 35%, transparent);
  }
  .numero {
    z-index: 1;
    box-shadow: 0 0 0 6px #fff;
  }
  @media (min-width: 1024px) {
    .ruta::before {
      left: 1.5rem;
      right: 1.5rem;
      top: 1.5rem;
      bottom: auto;
      border-left: 0;
      border-top: 2px dashed color-mix(in srgb, var(--color-tinta) 35%, transparent);
    }
    .numero {
      position: relative;
    }
  }
</style>
