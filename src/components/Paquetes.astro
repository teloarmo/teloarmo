---
import Icono from './Icono.astro';
import { paquetes, incluidoSiempre, notaTerceros } from '../data/paquetes';
import { precio } from '../lib/formato';
---

<section id="precios" class="bg-suave py-20 lg:py-24">
  <div class="wrap">
    <h2 class="titulo max-w-[20ch]">Precios</h2>
    <p class="mt-4 max-w-[52ch] text-gris">
      Elige según lo que necesita tu negocio. En la propuesta te damos el precio exacto antes de partir.
    </p>

    <div class="mt-12 grid gap-12 lg:grid-cols-3 lg:gap-0 lg:divide-x lg:divide-linea">
      {
        paquetes.map((p) => (
          <article class="flex flex-col lg:px-9 lg:first:pl-0 lg:last:pr-0">
            <h3 class="font-display text-[2rem] leading-none font-bold tracking-[-0.03em]">
              {p.nombre}
            </h3>
            <p class="mt-2 min-h-[3.1em] text-gris">{p.para}</p>
            <p class="etiqueta mt-5 self-start">
              <span class="text-base">desde</span>
              <span class="font-display text-[1.75rem] leading-none font-bold tracking-[-0.02em]">
                {precio(p.desde)}
              </span>
            </p>
            <ul class="mt-6 space-y-2.5">
              {p.incluye.map((item) => (
                <li class="flex gap-3">
                  <Icono nombre="check" class="mt-1 size-5 shrink-0 text-azul" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="mt-6 flex items-center gap-2 pt-1 text-gris lg:mt-auto lg:pt-6">
              <Icono nombre="reloj" class="size-5" />
              {p.plazo}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-14 max-w-[62ch] border-t border-linea pt-8">
      <p class="font-bold">{incluidoSiempre}</p>
      <p class="mt-3 text-gris">{notaTerceros}</p>
    </div>
  </div>
</section>
