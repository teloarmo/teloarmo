---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { ruta } from '../lib/formato';

interface Props {
  enInicio?: boolean;
}
const { enInicio = true } = Astro.props;
const pre = enInicio ? '' : ruta('/');
---

<footer class="bg-tinta text-white">
  <div class="wrap"><div class="border-t border-white/15"></div></div>
  <div class="wrap flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
    <div>
      <Logo claro />
      <p class="mt-3 text-white/75">{site.frase}</p>
    </div>
    <nav aria-label="Pie de página">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-white/85">
        <li><a class="hover:text-white hover:underline" href={`${pre}#precios`}>Precios</a></li>
        <li><a class="hover:text-white hover:underline" href={`${pre}#ejemplos`}>Ejemplos</a></li>
        <li><a class="hover:text-white hover:underline" href={`${pre}#preguntas`}>Preguntas</a></li>
        <li><a class="hover:text-white hover:underline" href={ruta('/privacidad')}>Privacidad</a></li>
        {
          site.instagram && (
            <li>
              <a class="hover:text-white hover:underline" href={site.instagram}>
                Instagram
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
  <div class="wrap pb-10 text-base text-white/60">© {site.anio} {site.nombre}</div>
</footer>
