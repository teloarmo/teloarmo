---
import Icono from './Icono.astro';
import { site } from '../data/site';
import { waLink } from '../lib/formato';
---

<section id="contacto" class="bg-tinta py-20 text-white lg:py-28">
  <div class="wrap grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:items-end">
    <div>
      <h2 class="display text-[clamp(2.2rem,5vw,3.8rem)]">¿Armamos la página de tu negocio?</h2>
      <p class="mt-6 max-w-[44ch] text-[1.2rem] text-white/85">
        Escríbenos y coordinamos una conversación de 20 minutos, en tu local o por videollamada. Te mostramos la
        portada de tu página antes de que pagues nada.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-azul" href={waLink(site.whatsapp, site.mensajeWhatsapp)}>
          <Icono nombre="chat" class="size-5" />
          Escríbenos por WhatsApp
        </a>
        {
          site.agendaUrl && (
            <a class="btn btn-linea text-white hover:border-white hover:bg-white hover:text-tinta" href={site.agendaUrl}>
              <Icono nombre="calendario" class="size-5" />
              Agendar una conversación
            </a>
          )
        }
      </div>
      {
        site.correo && (
          <p class="mt-6 flex items-center gap-2 text-white/85">
            <Icono nombre="correo" class="size-5" />
            <a class="underline underline-offset-4 hover:text-white" href={`mailto:${site.correo}`}>
              {site.correo}
            </a>
          </p>
        )
      }
    </div>

    <div class="border-t border-white/20 pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
      <h3 class="text-xl font-bold">Quiénes somos</h3>
      <p class="mt-3 text-white/85">
        Somos dos desarrolladores que hacemos páginas web para negocios de barrio. Trabajamos con pocos clientes a
        la vez, te explicamos todo sin palabras técnicas y te dejamos la página funcionando y a tu nombre.
      </p>
    </div>
  </div>
</section>
