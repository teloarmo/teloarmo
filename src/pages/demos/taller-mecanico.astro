</style>

<script>
  import { precio, waLink } from '../../lib/formato';

  const form = document.getElementById('cotizador') as HTMLFormElement;
  const cfg = JSON.parse(form.dataset.config!) as {
    numero: string;
    intro: string;
    servicios: { id: string; nombre: string; desde: number }[];
  };
  const enviar = form.querySelector('[data-enviar]') as HTMLAnchorElement;
  const total = form.querySelector('[data-total]') as HTMLElement;
  const falta = form.querySelector('[data-falta]') as HTMLElement;
  const campo = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();

  // No se puede elegir un día pasado.
  const hoy = new Date();
  (form.elements.namedItem('fecha') as HTMLInputElement).min =
    `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;

  const actualizar = () => {
    const elegidos = [...form.querySelectorAll<HTMLInputElement>('input[name="servicio"]:checked')]
      .map((i) => cfg.servicios.find((s) => s.id === i.value)!)
      .filter(Boolean);
    const suma = elegidos.reduce((s, x) => s + x.desde, 0);
    total.textContent = precio(suma);

    const marca = campo('marca');
    const listo = !!marca && elegidos.length > 0;
    enviar.setAttribute('aria-disabled', String(!listo));
    falta.hidden = listo;
    if (!listo) {
      enviar.removeAttribute('href');
      return;
    }
    const auto = [marca, campo('modelo'), campo('anio')].filter(Boolean).join(' ');
    const fecha = campo('fecha');
    const texto = [
      cfg.intro,
      `- Vehículo: ${auto}${campo('km') ? `, ${campo('km')} km` : ''}`,
      `- Servicios: ${elegidos.map((s) => s.nombre).join(', ')}`,
      `- Referencial: desde ${precio(suma)}`,
      campo('detalle') && `- Detalle: ${campo('detalle')}`,
      fecha && `- Quiero traerlo el: ${fecha.split('-').reverse().join('-')}`,
      campo('cliente') && `- Nombre: ${campo('cliente')}`,
    ].filter(Boolean);
    enviar.href = waLink(cfg.numero, texto.join('\n'));
  };

  form.addEventListener('input', actualizar);
  form.addEventListener('change', actualizar);

  // "Cotizar" en una tarjeta de servicio lo deja marcado en el formulario.
  document.querySelectorAll<HTMLAnchorElement>('[data-elegir]').forEach((a) =>
    a.addEventListener('click', () => {
      const input = form.querySelector<HTMLInputElement>(`input[name="servicio"][value="${a.dataset.elegir}"]`);
      if (input) input.checked = true;
      actualizar();
    }),
  );

  actualizar();
</script>
