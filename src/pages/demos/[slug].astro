---
// Inicio de la página de un negocio, generada desde su archivo en src/data/negocios.
// El catálogo con el pedido está en ./[slug]/catalogo.astro.
import Negocio from '../../layouts/Negocio.astro';
import Preguntas from '../../components/Preguntas.astro';
import Icono from '../../components/Icono.astro';
import Foto from '../../components/negocio/Foto.astro';
import MiniMapa from '../../components/negocio/MiniMapa.astro';
import { negocios, type Negocio as TNegocio } from '../../data/negocios';
import { site } from '../../data/site';
import { waLink, precio, ruta } from '../../lib/formato';

export function getStaticPaths() {
  return negocios.map((negocio) => ({ params: { slug: negocio.slug }, props: { negocio } }));
}

interface Props {
  negocio: TNegocio;
}
const { negocio: n } = Astro.props;
const catalogo = ruta(`/demos/${n.slug}/catalogo/`);
const msgDemo = `Hola, vi el ejemplo de ${n.nombre} en ${site.nombre} y me gustaría una página así para mi negocio.`;
const linkWa = waLink(n.ficticio ? site.whatsapp : n.whatsapp, n.ficticio ? msgDemo : 'Hola, tengo una consulta.');

const destacados = n.categorias.flatMap((c) => c.productos).filter((p) => p.destacado).slice(0, 4);
// Los letreros muy anchos se achican un poco para que el titular no ocupe tantas líneas.
const escala = Math.min(1, 105 / n.ancho).toFixed(3);
const armaTu = `Arma ${n.pedido.titulo.charAt(0).toLowerCase()}${n.pedido.titulo.slice(1)}`; // "Arma tu pedido"
---

<Negocio negocio={n} actual="inicio">
  <!-- Portada -->
  <section class="wrap grid gap-12 pt-8 pb-16 lg:grid-cols-[1fr_1.15fr] lg:items-center lg:gap-14 lg:pt-14 lg:pb-24">
    <div>
      <p class="tenue text-lg">{n.tipo} en {n.comuna}</p>
      <h1
        class="font-negocio mt-3 leading-[0.98] font-extrabold"
        style={`font-stretch:${n.ancho}%;font-size:calc(clamp(2.4rem,5.6vw,4.3rem) * ${escala})`}
      >
        {n.bajada}
      </h1>
      <p class="mt-6 max-w-[42ch] text-[1.2rem] leading-relaxed">{n.descripcion}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-demo" href={catalogo}>
          <Icono nombre="lista" class="size-5" />
          Ver catálogo
        </a>
        <a class="btn btn-demo-linea" href={linkWa}>
          <Icono nombre="chat" class="size-5" />
          Escríbenos
        </a>
      </div>
    </div>

    <div class="relative sm:pb-10">
      <Foto
        foto={n.fotos.portada}
        proporcion={5 / 4}
        prioridad
        sizes="(min-width: 1024px) 55vw, 100vw"
        anchos={[600, 1000, 1400]}
        respaldo={n.nombre}
        class="rounded-[1.75rem]"
      />
      <div
        class="panel relative z-[1] mx-4 -mt-14 rounded-2xl p-5 shadow-[0_12px_32px_-12px_rgba(0,0,0,0.35)] sm:absolute sm:bottom-0 sm:-left-6 sm:mx-0 sm:mt-0 sm:max-w-[22rem]"
      >
        <div class="flex gap-3">
          <Icono nombre="reloj" class="mt-0.5 size-6 shrink-0" />
          <div>
            {
              n.horarios.map((h) => (
                <p>
                  <span class="font-bold">{h.dias}:</span> {h.horas}
                </p>
              ))
            }
          </div>
        </div>
        <div class="mt-3 flex gap-3 border-t pt-3" style="border-color: var(--borde)">
          <Icono nombre="check" class="mt-0.5 size-6 shrink-0" />
          <p><span class="font-bold">{n.servicio.titulo}.</span> <span class="tenue">{n.servicio.texto}</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ventajas -->
  <section class="banda">
    <ul class="wrap grid gap-6 py-8 sm:grid-cols-3 sm:py-10">
      {
        n.ventajas.map((v) => (
          <li class="flex gap-4">
            <span
              class="flex size-11 shrink-0 items-center justify-center rounded-full text-white"
              style="background: var(--n-marca)"
            >
              <Icono nombre="check" class="size-5" />
            </span>
            <div>
              <p class="font-bold">{v.titulo}</p>
              <p class="tenue text-base">{v.texto}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Categorías -->
  <section class="py-16 lg:py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="titulo-negocio" style={`font-stretch:${n.ancho}%`}>Lo que encuentras</h2>
        <a class="font-bold underline underline-offset-4" href={catalogo}>Ver el catálogo completo</a>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-6 lg:grid-cols-4">
        {
          n.categorias.map((cat) => (
            <li>
              <a href={`${catalogo}#${cat.id}`} class="group block">
                <div class="overflow-hidden rounded-2xl">
                  <Foto
                    foto={cat.foto}
                    proporcion={4 / 3}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    respaldo={cat.nombre}
                    class="transition-transform duration-300 group-hover:scale-[1.04] motion-reduce:transition-none"
                  />
                </div>
                <h3 class="mt-3 text-lg leading-snug font-bold group-hover:underline sm:mt-4 sm:text-xl">{cat.nombre}</h3>
                <p class="tenue mt-1 text-base sm:text-lg">{cat.descripcion}</p>
                <p class="mt-2 text-base font-bold">{cat.productos.length} productos</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Destacados -->
  {
    destacados.length > 0 && (
      <section class="banda py-16 lg:py-20">
        <div class="wrap">
          <h2 class="titulo-negocio" style={`font-stretch:${n.ancho}%`}>
            Destacados
          </h2>
          <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
            {destacados.map((p) => (
              <li class="panel flex flex-col overflow-hidden rounded-2xl">
                <Foto
                  foto={p.foto}
                  proporcion={1}
                  sizes="(min-width: 1024px) 25vw, 50vw"
                  anchos={[300, 600, 900]}
                  respaldo={p.nombre}
                />
                <div class="flex flex-1 flex-col p-4">
                  <h3 class="leading-snug font-bold">{p.nombre}</h3>
                  {p.detalle && <p class="tenue text-base">{p.detalle}</p>}
                  <p class="mt-auto pt-3">
                    <span class="chip-precio rounded-md px-2 py-0.5 font-bold">{precio(p.precio)}</span>
                  </p>
                  <a class="btn btn-sm btn-demo mt-3 w-full" href={`${catalogo}#${p.id}`}>
                    {n.pedido.agregar}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Cómo pedir -->
  <section class="borde-t py-16 lg:py-20">
    <div class="wrap">
      <h2 class="titulo-negocio" style={`font-stretch:${n.ancho}%`}>Cómo pedir</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {
          n.pedido.pasos.map((paso, i) => (
            <li class="flex gap-4">
              <span
                class="font-negocio flex size-12 shrink-0 items-center justify-center rounded-full text-xl font-black text-white"
                style="background: var(--n-marca)"
              >
                {i + 1}
              </span>
              <div>
                <h3 class="text-xl font-bold">{paso.titulo}</h3>
                <p class="tenue mt-1">{paso.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Nosotros -->
  <section id="nosotros" class="banda py-16 lg:py-20">
    <div class="wrap grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <Foto
        foto={n.fotos.nosotros}
        proporcion={4 / 3}
        sizes="(min-width: 1024px) 50vw, 100vw"
        respaldo={n.nombre}
        class="rounded-[1.75rem]"
      />
      <div>
        <h2 class="titulo-negocio" style={`font-stretch:${n.ancho}%`}>{n.nosotros.titulo}</h2>
        {n.nosotros.texto.map((t) => <p class="mt-4 max-w-[52ch] text-[1.15rem] leading-relaxed">{t}</p>)}
      </div>
    </div>
  </section>

  <!-- Ubicación -->
  <section id="ubicacion" class="borde-t py-16 lg:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-start">
      <div>
        <h2 class="titulo-negocio" style={`font-stretch:${n.ancho}%`}>Cómo llegar</h2>
        <p class="mt-4 flex gap-2 text-lg">
          <Icono nombre="pin" class="mt-1 size-5 shrink-0" />
          {n.direccion}, {n.comuna}
        </p>
        <h3 class="mt-8 font-bold">Horarios</h3>
        <dl class="mt-2">
          {
            n.horarios.map((h) => (
              <div class="flex justify-between gap-4 border-b py-2" style="border-color: var(--borde)">
                <dt>{h.dias}</dt>
                <dd class="font-bold">{h.horas}</dd>
              </div>
            ))
          }
        </dl>
        <h3 class="mt-8 font-bold">Medios de pago</h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          {n.mediosDePago.map((m) => <li class="panel rounded-full px-3 py-1 text-base">{m}</li>)}
        </ul>
      </div>
      <div>
        <MiniMapa color={n.colores.marca} nombre={n.nombre} />
        {
          n.ficticio && (
            <p class="tenue mt-3 text-base">Mapa de referencia. En tu página va el mapa de Google con tu dirección.</p>
          )
        }
      </div>
    </div>
  </section>

  <!-- Preguntas -->
  <section class="banda py-16 lg:py-20">
    <div class="wrap grid gap-8 lg:grid-cols-[1fr_2fr]">
      <h2 class="titulo-negocio" style={`font-stretch:${n.ancho}%`}>Preguntas frecuentes</h2>
      <Preguntas items={n.preguntas} />
    </div>
  </section>

  <!-- Llamado final -->
  <section class="wrap py-16 lg:py-20">
    <div class="flex flex-col items-start gap-6 rounded-[1.75rem] p-8 text-white sm:p-12 md:flex-row md:items-center md:justify-between" style="background: var(--n-texto)">
      <div>
        <h2 class="titulo-negocio" style={`font-stretch:${n.ancho}%`}>{armaTu} desde el celular</h2>
        <p class="mt-3 max-w-[46ch] text-white/85">Elige en el catálogo y te llega por WhatsApp con todo el detalle.</p>
      </div>
      <a class="btn btn-demo shrink-0" href={catalogo}>Ver catálogo</a>
    </div>
  </section>

  <div slot="barra" class="barra-movil fixed inset-x-0 bottom-0 z-20 flex gap-2 p-3 md:hidden">
    <a class="btn btn-demo flex-1" href={catalogo}>
      <Icono nombre="lista" class="size-5" />
      Ver catálogo
    </a>
    <a class="btn btn-demo-linea" href={linkWa} aria-label="Escríbenos por WhatsApp">
      <Icono nombre="chat" class="size-5" />
    </a>
  </div>
</Negocio>

<style>
  /* Espacio para la barra fija del celular. */
  @media (max-width: 767px) {
    :global(.pie) {
      padding-bottom: 5rem;
    }
  }
</style>
